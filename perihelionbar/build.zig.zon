    // That will add the correct `.hash` field automatically and pin a
    // specific commit. Don't hand-write the hash.
    .dependencies = .{
        .wayland = .{
            .url = "git+https://codeberg.org/ifreund/zig-wayland?ref=v0.7.0#fc7672f661874aa2015fc19a87ebabce787cf1c7",
            .hash = "wayland-0.7.0-lQa1kuP8AQD5dW7_o-VKLVD_QbqXe7Zob78r2su7Pyex",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "protocols",
    },
}
