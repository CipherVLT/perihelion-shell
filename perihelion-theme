        "accents": {a: p[a] for a in ACCENTS},
        "ansi": ("red", "green", "yellow", "blue", "pink", "teal"),
        "default": DEFAULT_ACCENTS,
    }


def _preset(name, light, neutrals, accents, ansi, default):
    return {"name": name, "light": light, "neutrals": neutrals, "accents": accents,
            "ansi": ansi, "default": default}


