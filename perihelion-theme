NEAR_HUE_GAP = 20.0


# --- color math (OKLab: perceptual, so "closest" means what eyes see) --------
def hex_rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def _lin(c):
    c /= 255.0
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def oklab(rgb):
    r, g, b = (_lin(c) for c in rgb)
    l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b
    m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b
    s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b
    l, m, s = (math.copysign(abs(x) ** (1 / 3), x) for x in (l, m, s))
    return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
            1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
            0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)


def lch(rgb):
    L, a, b = oklab(rgb)
    return L, math.hypot(a, b), math.degrees(math.atan2(b, a)) % 360


def hue_gap(h1, h2):
    d = abs(h1 - h2) % 360
    return min(d, 360 - d)


# --- reading the wallpaper ----------------------------------------------------
def load_pixels(path, size=96):
    """A small thumbnail's pixels as (r, g, b) tuples (transparent ones dropped)."""
    try:
        import gi
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
        data, stride, n = pb.get_pixels(), pb.get_rowstride(), pb.get_n_channels()
        alpha = pb.get_has_alpha()
        out = []
        for y in range(pb.get_height()):
            row = y * stride
            for x in range(pb.get_width()):
                i = row + x * n
                if alpha and data[i + 3] < 128:
                    continue
                out.append((data[i], data[i + 1], data[i + 2]))
        return out
    except ImportError:
        pass
    try:  # for testing on machines without PyGObject
        from PIL import Image
    except ImportError:
        raise SystemExit("perihelion-theme: needs python3-gobject (GdkPixbuf) to read images")
    with Image.open(path) as im:
        im = im.convert("RGBA")
        im.thumbnail((size, size))
        return [p[:3] for p in list(im.getdata()) if p[3] >= 128]


def pick_flavor(pixels):
    """Lightness of the whole picture → the flavor that sits on it best."""
    if not pixels:
        return "macchiato"
    mean_l = sum(oklab(p)[0] for p in pixels) / len(pixels)
    if mean_l >= 0.76:
        return "latte"
    if mean_l >= 0.58:
        return "frappe"
    if mean_l >= 0.38:
        return "macchiato"
    return "mocha"


def pick_accents(pixels, flavor):
    """The three Catppuccin accents the wallpaper's colors land on most.

    Each colorful pixel votes for the accent with the nearest hue, weighted
    by how colorful it is, so a vivid streak beats a large dull area. Grey
    pixels don't vote. Picks are kept at least MIN_HUE_GAP apart so the
    wave's gradient has three colors you can tell apart."""
    pal = PALETTES[flavor]
    accent_lch = {a: lch(hex_rgb(pal[a])) for a in ACCENTS}
    max_c = max(v[1] for v in accent_lch.values())
    rel = {a: accent_lch[a][1] / max_c for a in ACCENTS}
    votes = dict.fromkeys(ACCENTS, 0.0)
    for p in pixels:
        L, C, H = lch(p)
        if C < 0.045 or L < 0.12 or L > 0.98:
            continue
        # Nearest hue, but a vivid pixel goes to a vivid accent: a strong red
        # is Catppuccin red, not pale rosewater (which sits nearer in hue).
        c = min(C, max_c) / max_c

        def distance(a):
            return (hue_gap(H, accent_lch[a][2]) + 40 * max(0.0, c - rel[a])
                    + 10 * max(0.0, rel[a] - c))
        votes[min(ACCENTS, key=distance)] += C
    total = sum(votes.values())
    ranked = [a for a in sorted(ACCENTS, key=votes.get, reverse=True)
              if votes[a] > 0 and votes[a] >= 0.04 * total]
    if total < 0.004 * len(pixels):  # hardly any color: a grey wallpaper
        ranked = []

    # The wallpaper's own colors first, well apart; then its colors that sit
    # closer together (pink beside mauve); only then Perihelion's defaults.
    chosen = []
    for pool, gap in ((ranked, MIN_HUE_GAP), (ranked, NEAR_HUE_GAP),
                      (DEFAULT_ACCENTS, MIN_HUE_GAP), (DEFAULT_ACCENTS, 0)):
        for a in pool:
            if len(chosen) == 3:
                return chosen, votes
            if a not in chosen and all(
                    hue_gap(accent_lch[a][2], accent_lch[c][2]) >= gap for c in chosen):
                chosen.append(a)
    return chosen, votes


# --- the palette every target is drawn from ---------------------------------
def build_theme(flavor, accents):
    p = PALETTES[flavor]
    a1, a2, a3 = accents
    return {
        "flavor": flavor,
        "accents": list(accents),
        "colors": {k: "#" + v for k, v in p.items()},
        "accent": "#" + p[a1], "accent2": "#" + p[a2], "accent3": "#" + p[a3],
    }


