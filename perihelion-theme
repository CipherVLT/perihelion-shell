# --- color math (OKLab: perceptual, so "closest" means what eyes see) --------
def hex_rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def _lin(c):
    c /= 255.0
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def oklab(rgb):
    r, g, b = (_lin(c) for c in rgb)
    l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b
    m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b
    s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b
    l, m, s = (math.copysign(abs(x) ** (1 / 3), x) for x in (l, m, s))
    return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
            1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
            0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)


def lch(rgb):
    L, a, b = oklab(rgb)
    return L, math.hypot(a, b), math.degrees(math.atan2(b, a)) % 360


def _delin(c):
    c = 12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055
    return c


def oklch_hex(L, C, H):
    """OKLCh to "#rrggbb", lowering chroma until the color fits in sRGB."""
    for _ in range(40):
        a, b = C * math.cos(math.radians(H)), C * math.sin(math.radians(H))
        l_ = L + 0.3963377774 * a + 0.2158037573 * b
        m_ = L - 0.1055613458 * a - 0.0638541728 * b
        s_ = L - 0.0894841775 * a - 1.2914855480 * b
        l, m, s = l_ ** 3, m_ ** 3, s_ ** 3
        rgb = (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
               -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
               -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)
        if all(-0.0005 <= x <= 1.0005 for x in rgb):
            break
        C *= 0.9
    return "#" + "".join(f"{round(min(1.0, max(0.0, _delin(min(1.0, max(0.0, x))))) * 255):02x}"
                         for x in rgb)


def hue_gap(h1, h2):
    d = abs(h1 - h2) % 360
    return min(d, 360 - d)


# --- reading the wallpaper ----------------------------------------------------
def load_pixels(path, size=96):
    """A small thumbnail's pixels as (r, g, b) tuples (transparent ones dropped)."""
    try:
        import gi
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
        data, stride, n = pb.get_pixels(), pb.get_rowstride(), pb.get_n_channels()
        alpha = pb.get_has_alpha()
        out = []
        for y in range(pb.get_height()):
            row = y * stride
            for x in range(pb.get_width()):
                i = row + x * n
                if alpha and data[i + 3] < 128:
                    continue
                out.append((data[i], data[i + 1], data[i + 2]))
        return out
    except ImportError:
        pass
    try:  # for testing on machines without PyGObject
        from PIL import Image
    except ImportError:
        raise SystemExit("perihelion-theme: needs python3-gobject (GdkPixbuf) to read images")
    with Image.open(path) as im:
        im = im.convert("RGBA")
        im.thumbnail((size, size))
        return [p[:3] for p in list(im.getdata()) if p[3] >= 128]


def mean_lightness(pixels):
    return sum(oklab(p)[0] for p in pixels) / len(pixels) if pixels else 0.3


def resolve_palette(choice, pixels):
    """A PALETTE_CHOICES value → a PRESETS id ("-auto" goes by lightness)."""
    if choice in PRESETS:
        return choice
    L = mean_lightness(pixels)
    if choice == "gruvbox-auto":
        return "gruvbox-light" if L >= 0.76 else "gruvbox-dark"
    if choice == "rose-pine-auto":
        return "rose-pine-dawn" if L >= 0.76 else ("rose-pine-moon" if L >= 0.45 else "rose-pine")
    return "catppuccin-" + pick_flavor(pixels)


def pick_flavor(pixels):
    """Lightness of the whole picture → the flavor that sits on it best."""
    if not pixels:
        return "macchiato"
    mean_l = mean_lightness(pixels)
    if mean_l >= 0.76:
        return "latte"
    if mean_l >= 0.58:
        return "frappe"
    if mean_l >= 0.38:
        return "macchiato"
    return "mocha"


def pick_accents(pixels, flavor):
    """Catppuccin wrapper kept for callers that name a flavor."""
    chosen, votes, _ = pick_preset_accents(pixels, "catppuccin-" + flavor)
    return chosen, votes


def pick_preset_accents(pixels, preset_id):
    """The three Catppuccin accents the wallpaper's colors land on most.

    Each colorful pixel votes for the accent with the nearest hue, weighted
    by how colorful it is, so a vivid streak beats a large dull area. Grey
    pixels don't vote. Picks are kept at least MIN_HUE_GAP apart so the
    wave's gradient has three colors you can tell apart."""
    preset = PRESETS[preset_id]
    names = tuple(preset["accents"])
    accent_lch = {a: lch(hex_rgb(preset["accents"][a])) for a in names}
    max_c = max(v[1] for v in accent_lch.values())
    rel = {a: accent_lch[a][1] / max_c for a in names}
    votes = dict.fromkeys(names, 0.0)
    # Circular mean of the hue each accent's voters really have: the tint
    # follows the wallpaper itself, not the palette's nearest accent.
    hue_sum = {a: [0.0, 0.0] for a in names}
    for p in pixels:
        L, C, H = lch(p)
        if C < 0.045 or L < 0.12 or L > 0.98:
            continue
        # Nearest hue, but a vivid pixel goes to a vivid accent: a strong red
        # is Catppuccin red, not pale rosewater (which sits nearer in hue).
        c = min(C, max_c) / max_c

        def distance(a):
            return (hue_gap(H, accent_lch[a][2]) + 40 * max(0.0, c - rel[a])
                    + 10 * max(0.0, rel[a] - c))
        won = min(names, key=distance)
        votes[won] += C
        hue_sum[won][0] += C * math.cos(math.radians(H))
        hue_sum[won][1] += C * math.sin(math.radians(H))
    total = sum(votes.values())
    ranked = [a for a in sorted(names, key=votes.get, reverse=True)
              if votes[a] > 0 and votes[a] >= 0.04 * total]
    if total < 0.004 * len(pixels):  # hardly any color: a grey wallpaper
        ranked = []
    # The wallpaper's main hue and how colorful it is, for the tint.
    tint = None
    if ranked:
        x, y = hue_sum[ranked[0]]
        strength = min(1.0, (total / max(1, len(pixels))) / 0.03)
        tint = (math.degrees(math.atan2(y, x)) % 360, strength)

    # The wallpaper's own colors first, well apart; then its colors that sit
    # closer together (pink beside mauve); only then Perihelion's defaults.
    chosen = []
    default = [a for a in preset["default"] if a in names] + list(names)
    for pool, gap in ((ranked, MIN_HUE_GAP), (ranked, NEAR_HUE_GAP),
                      (default, MIN_HUE_GAP), (default, 0)):
        for a in pool:
            if len(chosen) == 3:
                return chosen, votes, tint
            if a not in chosen and all(
                    hue_gap(accent_lch[a][2], accent_lch[c][2]) >= gap for c in chosen):
                chosen.append(a)
    return chosen, votes, tint


# --- the palette every target is drawn from ---------------------------------
def build_theme(preset_id, accents, tint=None):
    """The palette every writer draws from. tint=(hue, strength) moves the
    neutral steps (backgrounds, surfaces, text) onto the wallpaper's hue."""
    if preset_id in PALETTES:  # a bare Catppuccin flavor name
        preset_id = "catppuccin-" + preset_id
    pre = PRESETS[preset_id]
    acc = pre["accents"]
    a1, a2, a3 = accents
    colors = {k: "#" + v for k, v in pre["neutrals"].items()}
    colors.update({k: "#" + v for k, v in acc.items()})
    red, green, yellow, blue, magenta, cyan = (acc[n] for n in pre["ansi"])
    colors.update({"red": "#" + red, "ansi_green": "#" + green, "ansi_yellow": "#" + yellow,
                   "ansi_blue": "#" + blue, "ansi_magenta": "#" + magenta, "ansi_cyan": "#" + cyan})
    if tint:
        colors.update(tinted_neutrals(colors, tint, pre["light"]))
    return {
        "flavor": preset_id, "name": pre["name"], "light": pre["light"], "tint": tint,
        "accents": list(accents),
