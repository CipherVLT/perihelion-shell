           "source_optional=~/.config/mango/colors.conf\n")
    return write(conf, cur.rstrip("\n") + "\n" + add)


def pids(name):
    try:
        return subprocess.run(["pgrep", "-x", name], capture_output=True, text=True,
                              timeout=5, check=False).stdout.split()
    except (OSError, subprocess.SubprocessError):
        return []


def running(name):
    return bool(pids(name))


def signal_procs(names, sig):
    for name in names:
        for pid in pids(name):
            try:
                os.kill(int(pid), sig)
            except (OSError, ValueError):
                pass


# --- settings and inputs ---------------------------------------------------
def read_settings():
    s = {"style": "catppuccin", "palette": "catppuccin-auto", "tint": True,
         "accent": "wallpaper", "scheme": "scheme-tonal-spot", "mode": "dark"}
    text = read(os.path.join(SIMPBAR, "theme")) or ""
    for line in text.splitlines():
        k, sep, v = line.partition("=")
        k, v = k.strip(), v.strip().lower()
        if not sep:
            continue
        if k == "flavor" and v in ("auto",) + FLAVORS and "palette_set" not in s:
            s["palette"] = "catppuccin-" + v  # older theme files
        elif k == "palette" and v in PALETTE_CHOICES:
            s["palette"], s["palette_set"] = v, True
        elif k == "tint" and v in ("on", "off"):
            s["tint"] = v == "on"
        elif k == "mode" and v in ("dark", "light", "auto"):
            s["mode"] = v
        elif k == "accent" and v in ("wallpaper", "flavor"):
            s["accent"] = v
        elif k == "style" and v in ("catppuccin", "material"):
            s["style"] = v
        elif k == "scheme" and v in MATUGEN_SCHEMES:
            s["scheme"] = v
    s.pop("palette_set", None)
    return s


def auto_theme_off():
    try:
        with open(os.path.join(SIMPBAR, "config.json"), encoding="utf-8") as f:
            return json.load(f).get("appearance", {}).get("auto_theme") == "manual"
    except (OSError, ValueError, AttributeError):
        return False


def current_wallpaper():
    """('image', path) or ('color', '#rrggbb') or (None, None)."""
    state = read(os.path.join(CONFIG, "perihelion", "wallpaper"))
    if state:
        kind, _, value = state.strip().partition(" ")
        if kind == "image" and os.path.isfile(value):
            return "image", value
        if kind == "color" and re.fullmatch(r"#[0-9A-Fa-f]{6}", value):
            return "color", value
    sb = read(os.path.join(SIMPBAR, "wallpaper")) or ""
    m = re.search(r"(?m)^path=(.+)$", sb)
    if m and os.path.isfile(m.group(1)):
        return "image", m.group(1)
    default = "/usr/share/backgrounds/perihelion/default.png"
    if os.path.isfile(default):
        return "image", default
    return None, None


def main(argv=None):
    ap = argparse.ArgumentParser(prog="perihelion-theme",
                                 description="Catppuccin colors matched to the wallpaper.")
    ap.add_argument("image", nargs="?")
    ap.add_argument("--color")
    ap.add_argument("--flavor", choices=("auto",) + FLAVORS)
    ap.add_argument("--palette", choices=PALETTE_CHOICES)
    ap.add_argument("--tint", choices=("on", "off"))
    ap.add_argument("--mode", choices=("dark", "light", "auto"))
    ap.add_argument("--accent", choices=("wallpaper", "flavor"))
    ap.add_argument("--style", choices=("catppuccin", "material"))
    ap.add_argument("--scheme", choices=MATUGEN_SCHEMES)
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args(argv)

    if not args.dry_run and auto_theme_off():
        print("perihelion-theme: 'Match the wallpaper' is off in Simpbar Config; nothing to do")
        return 0

    settings = read_settings()
    palette_setting = (args.palette or ("catppuccin-" + args.flavor if args.flavor else None)
                       or settings["palette"])
    tint_on = (args.tint == "on") if args.tint else settings["tint"]
    mode_setting = args.mode or settings["mode"]
    accent_setting = args.accent or settings["accent"]
    style = args.style or settings["style"]
    scheme = args.scheme or settings["scheme"]

    if args.color:
        if not re.fullmatch(r"#?[0-9A-Fa-f]{6}", args.color):
            ap.error("--color takes #RRGGBB")
        kind, value = "color", "#" + args.color.lstrip("#")
    elif args.image:
        if not os.path.isfile(args.image):
            ap.error(f"no such file: {args.image}")
        kind, value = "image", os.path.realpath(args.image)
    else:
        kind, value = current_wallpaper()

    # Skip the work when nothing changed since the last run (login restores).
    stamp_src = (f"{kind}|{value}|{style}|{scheme}|{mode_setting}|{palette_setting}|"
                 f"{tint_on}|{accent_setting}|11")
    if kind == "image":
        try:
            stamp_src += f"|{os.path.getmtime(value)}"
        except OSError:
            pass
    stamp = hashlib.sha1(stamp_src.encode()).hexdigest()
    stamp_path = os.path.join(CACHE, "perihelion-theme", "last")
    if not (args.force or args.dry_run) and read(stamp_path) == stamp \
            and os.path.isfile(os.path.join(SIMPBAR, "matugen.json")):
        return 0

    if kind == "image":
        try:
            pixels = load_pixels(value)
        except Exception as e:  # an image format with no loader installed, a broken file
            print(f"perihelion-theme: could not read {value} ({e}); using the flavor's colors",
                  file=sys.stderr)
            pixels = []
    elif kind == "color":
        pixels = [hex_rgb(value.lstrip("#"))] * 64
    else:
        pixels = []

    theme = None
    if style == "material" and kind:
        mode = mode_setting
        if mode == "auto":
            mode = "light" if mean_lightness(pixels) >= 0.76 else "dark"
        try:
            theme = build_material(run_matugen(kind, value, scheme, mode), light=mode == "light")
            accents, votes = theme["accents"], {}
            preset = "material"
        except (RuntimeError, ValueError) as e:
            print(f"perihelion-theme: {e}; using Catppuccin instead", file=sys.stderr)

    if theme is None:
        preset = resolve_palette(palette_setting, pixels)
        accents, votes, tint = pick_preset_accents(pixels, preset) if pixels else ([], {}, None)
        if accent_setting != "wallpaper" or not pixels:
            names = PRESETS[preset]["accents"]
            accents = [a for a in PRESETS[preset]["default"] if a in names][:3]
        theme = build_theme(preset, accents, tint if tint_on else None)
    flavor = preset[len("catppuccin-"):] if preset.startswith("catppuccin-") else preset

    if args.dry_run:
        print(json.dumps({"source": value, "style": style, "palette": preset, "flavor": flavor,
                          "tint": theme.get("tint"), "accents": accents,
                          "votes": {k: round(v, 2) for k, v in votes.items() if v},
                          "matugen": matugen_json(theme)}, indent=2, ensure_ascii=False))
        return 0

    changed = []
    if write(os.path.join(SIMPBAR, "matugen.json"),
             json.dumps(matugen_json(theme), indent=2) + "\n"):
        changed.append("bar")

    drawer = os.path.join(CONFIG, "nwg-drawer", "drawer.css")
    if ours_or_default(drawer, os.path.join(SHARE, "nwg-drawer", "drawer.css")):
        if write(drawer, drawer_css(theme)):
            changed.append("drawer")

    if update_fuzzel(os.path.join(CONFIG, "fuzzel", "fuzzel.ini"), fuzzel_colors(theme),
                     os.path.join(SHARE, "fuzzel", "fuzzel.ini")):
        changed.append("fuzzel")

    strata = os.path.join(CONFIG, "strata", "themes", "tokyo-night.toml")
    cur = read(strata)
    if cur is None or MARKER in cur or "# perihelion: generated from the GTK theme" in cur:
        if write(strata, strata_toml(theme)):
            changed.append("strata")

    mango_dir = os.path.join(CONFIG, "mango")
    if os.path.isdir(mango_dir):
        wrote = write(os.path.join(mango_dir, "colors.conf"), mango_conf(theme))
        ensure_mango_source(os.path.join(mango_dir, "config.conf"))
        if wrote:
            changed.append("mango")
            if shutil.which("mmsg") and (os.environ.get("MANGO_INSTANCE_SIGNATURE")
                                         or running("mango")):
                try:
                    subprocess.run(["mmsg", "dispatch", "reload_config"],
                                   capture_output=True, check=False, timeout=5)
                except (OSError, subprocess.SubprocessError):
                    pass

    if update_fastfetch(os.path.join(CONFIG, "fastfetch", "config.jsonc"), theme,
                        os.path.join(SHARE, "fastfetch", "config.jsonc")):
        changed.append("fastfetch")

    if update_cava(os.path.join(CONFIG, "cava", "config"), theme,
                   os.path.join(SHARE, "cava", "config")):
        changed.append("cava")
        signal_procs(("cava",), signal.SIGUSR2)  # cava rereads its colors on USR2

    if write(os.path.join(CONFIG, "btop", "themes", "perihelion.theme"), btop_theme(theme)):
        changed.append("btop")
    if write(os.path.join(CONFIG, "perihelion", "cmatrix-color"), cmatrix_color(theme) + "\n"):
        changed.append("cmatrix")

    mako = os.path.join(CONFIG, "mako", "config")
    cur = read(mako)
    if shutil.which("mako") and (cur is None or f"written by {MARKER}" in cur):
        if write(mako, mako_config(theme)):
            changed.append("notifications")
            if running("mako") and shutil.which("makoctl"):
                try:
                    subprocess.run(["makoctl", "reload"], capture_output=True, timeout=5, check=False)
                except (OSError, subprocess.SubprocessError):
                    pass

    # kitty: a colors file kitty.conf includes; open terminals reload it (USR1).
    kitty_dir = os.path.join(CONFIG, "kitty")
    if shutil.which("kitty") or os.path.isdir(kitty_dir):
        if write(os.path.join(kitty_dir, "perihelion-colors.conf"), kitty_colors(theme)):
            changed.append("terminal")
            signal_procs(("kitty",), signal.SIGUSR1)

    # The login screen: same picture, same colors (Perihelion's helper; it
    # does nothing for someone who may not change the shared greeter).
    greeter = shutil.which("perihelion-greeter-sync")
    if greeter and kind:
        src = ["--image", value] if kind == "image" else ["--color", value]
        c = theme["colors"]
        try:
            r = subprocess.run([greeter, *src, "--bg", c["base"], "--text", c["text"],
                                "--accent", theme["accent"]],
                               capture_output=True, text=True, timeout=30, check=False)
            if r.returncode == 0:
                changed.append("login screen")
        except (OSError, subprocess.SubprocessError):
            pass

    signal_procs(("simpbar", "simpbar-shell"), signal.SIGUSR1)
    write(stamp_path, stamp)
    print(f"perihelion-theme: {theme['name']}{', tinted' if theme.get('tint') else ''}, accents "
          f"{', '.join(accents)}" + (f" ({', '.join(changed)} updated)" if changed else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
