# --- writing ------------------------------------------------------------------
def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None


def write(path, text):
    """Atomic write; returns True when the content changed."""
    if read(path) == text:
        return False
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix="." + os.path.basename(path) + ".")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)
    return True


def ours_or_default(path, default_path):
    """May we rewrite this file? Yes when it's missing, carries our marker, or
    is still byte-for-byte the default Perihelion shipped."""
    cur = read(path)
    if cur is None:
        return True
    if f"Written by {MARKER}" in cur:
        return True
    default = read(default_path) if default_path else None
    return default is not None and cur == default


def update_fuzzel(path, colors, default_path):
    """Rewrite the values in fuzzel.ini's [colors] section, nothing else, and
    only while that section is still Perihelion's (marked, or the default)."""
    cur = read(path)
    if cur is None:
        return False

    def colors_section(text):
        m = re.search(r"(?ms)^\[colors\][^\n]*\n(.*?)(?=^\[|\Z)", text)
        return m

    sec = colors_section(cur)
    if not sec:
        return False
    body = sec.group(1)
    default = read(default_path) if default_path else None
    dsec = colors_section(default) if default else None
    if MARKER not in body and not (dsec and dsec.group(1).strip() == body.strip()):
        return False
    lines = [f"# {MARKER}: these colors follow the wallpaper; remove this line to keep your own"]
    for k, v in colors.items():
        lines.append(f"{k}={v}")
    new = cur[:sec.start(1)] + "\n".join(lines) + "\n\n" + cur[sec.end(1):].lstrip("\n")
    return write(path, new)


def ensure_mango_source(conf):
    cur = read(conf)
    if cur is None or "mango/colors.conf" in cur:
        return False
    add = ("\n# Window border colors follow the wallpaper (perihelion-theme). Keep last.\n"
           "source_optional=~/.config/mango/colors.conf\n")
    return write(conf, cur.rstrip("\n") + "\n" + add)


def signal_procs(names, sig):
    for name in names:
        try:
            out = subprocess.run(["pgrep", "-x", name], capture_output=True, text=True,
                                 timeout=5, check=False).stdout.split()
        except (OSError, subprocess.SubprocessError):
            continue
        for pid in out:
            try:
                os.kill(int(pid), sig)
            except (OSError, ValueError):
                pass


# --- settings and inputs ---------------------------------------------------
def read_settings():
    s = {"flavor": "auto", "accent": "wallpaper"}
    text = read(os.path.join(SIMPBAR, "theme")) or ""
    for line in text.splitlines():
        k, sep, v = line.partition("=")
        k, v = k.strip(), v.strip().lower()
        if not sep:
            continue
        if k == "flavor" and v in ("auto",) + FLAVORS:
            s["flavor"] = v
        elif k == "accent" and v in ("wallpaper", "flavor"):
            s["accent"] = v
    return s


def auto_theme_off():
    try:
        with open(os.path.join(SIMPBAR, "config.json"), encoding="utf-8") as f:
            return json.load(f).get("appearance", {}).get("auto_theme") == "manual"
    except (OSError, ValueError, AttributeError):
        return False


def current_wallpaper():
    """('image', path) or ('color', '#rrggbb') or (None, None)."""
    state = read(os.path.join(CONFIG, "perihelion", "wallpaper"))
    if state:
        kind, _, value = state.strip().partition(" ")
        if kind == "image" and os.path.isfile(value):
            return "image", value
        if kind == "color" and re.fullmatch(r"#[0-9A-Fa-f]{6}", value):
            return "color", value
    sb = read(os.path.join(SIMPBAR, "wallpaper")) or ""
    m = re.search(r"(?m)^path=(.+)$", sb)
    if m and os.path.isfile(m.group(1)):
        return "image", m.group(1)
    default = "/usr/share/backgrounds/perihelion/default.png"
    if os.path.isfile(default):
        return "image", default
    return None, None


def main(argv=None):
    ap = argparse.ArgumentParser(prog="perihelion-theme",
                                 description="Catppuccin colors matched to the wallpaper.")
    ap.add_argument("image", nargs="?")
    ap.add_argument("--color")
    ap.add_argument("--flavor", choices=("auto",) + FLAVORS)
    ap.add_argument("--accent", choices=("wallpaper", "flavor"))
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args(argv)

    if not args.dry_run and auto_theme_off():
        print("perihelion-theme: Catppuccin theme is off in Simpbar Config; nothing to do")
        return 0

    settings = read_settings()
    flavor_setting = args.flavor or settings["flavor"]
    accent_setting = args.accent or settings["accent"]

    if args.color:
        if not re.fullmatch(r"#?[0-9A-Fa-f]{6}", args.color):
            ap.error("--color takes #RRGGBB")
        kind, value = "color", "#" + args.color.lstrip("#")
    elif args.image:
        if not os.path.isfile(args.image):
            ap.error(f"no such file: {args.image}")
        kind, value = "image", os.path.realpath(args.image)
    else:
        kind, value = current_wallpaper()

    # Skip the work when nothing changed since the last run (login restores).
    stamp_src = f"{kind}|{value}|{flavor_setting}|{accent_setting}|6"
    if kind == "image":
        try:
            stamp_src += f"|{os.path.getmtime(value)}"
        except OSError:
            pass
    stamp = hashlib.sha1(stamp_src.encode()).hexdigest()
    stamp_path = os.path.join(CACHE, "perihelion-theme", "last")
    if not (args.force or args.dry_run) and read(stamp_path) == stamp \
            and os.path.isfile(os.path.join(SIMPBAR, "matugen.json")):
        return 0

    if kind == "image":
        try:
            pixels = load_pixels(value)
        except Exception as e:  # an image format with no loader installed, a broken file
            print(f"perihelion-theme: could not read {value} ({e}); using the flavor's colors",
                  file=sys.stderr)
            pixels = []
    elif kind == "color":
        pixels = [hex_rgb(value.lstrip("#"))] * 64
    else:
        pixels = []

    flavor = pick_flavor(pixels) if flavor_setting == "auto" else flavor_setting
    if accent_setting == "wallpaper" and pixels:
        accents, votes = pick_accents(pixels, flavor)
    else:
        accents, votes = list(DEFAULT_ACCENTS[:3]), {}
    theme = build_theme(flavor, accents)

    if args.dry_run:
        print(json.dumps({"source": value, "flavor": flavor, "accents": accents,
                          "votes": {k: round(v, 2) for k, v in votes.items() if v},
                          "matugen": matugen_json(theme)}, indent=2, ensure_ascii=False))
        return 0

    changed = []
    if write(os.path.join(SIMPBAR, "matugen.json"),
             json.dumps(matugen_json(theme), indent=2) + "\n"):
        changed.append("bar")

    drawer = os.path.join(CONFIG, "nwg-drawer", "drawer.css")
    if ours_or_default(drawer, os.path.join(SHARE, "nwg-drawer", "drawer.css")):
        if write(drawer, drawer_css(theme)):
            changed.append("drawer")

    if update_fuzzel(os.path.join(CONFIG, "fuzzel", "fuzzel.ini"), fuzzel_colors(theme),
                     os.path.join(SHARE, "fuzzel", "fuzzel.ini")):
        changed.append("fuzzel")

    strata = os.path.join(CONFIG, "strata", "themes", "tokyo-night.toml")
    cur = read(strata)
    if cur is None or MARKER in cur or "# perihelion: generated from the GTK theme" in cur:
        if write(strata, strata_toml(theme)):
            changed.append("strata")

    mango_dir = os.path.join(CONFIG, "mango")
    if os.path.isdir(mango_dir):
        wrote = write(os.path.join(mango_dir, "colors.conf"), mango_conf(theme))
        ensure_mango_source(os.path.join(mango_dir, "config.conf"))
        if wrote:
            changed.append("mango")
            running = os.environ.get("MANGO_INSTANCE_SIGNATURE") or subprocess.run(
                ["pgrep", "-x", "mango"], capture_output=True, check=False).returncode == 0
            if running and shutil.which("mmsg"):
                subprocess.run(["mmsg", "dispatch", "reload_config"],
                               capture_output=True, check=False, timeout=5)

    signal_procs(("simpbar", "simpbar-shell"), signal.SIGUSR1)
    write(stamp_path, stamp)
    print(f"perihelion-theme: Catppuccin {FLAVOR_NAMES[flavor]}, accents "
          f"{', '.join(accents)}" + (f" ({', '.join(changed)} updated)" if changed else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
