def _hue(h):
    return lch(hex_rgb(h.lstrip("#")))[2]


def section_colors(t):
    """(OS, WM, PC) for fastfetch: OS the palette's red-pink; WM and PC two
    of the wallpaper's accents with clearly different hues (from each other
    and from OS). When the wallpaper has fewer distinct hues, a lighter tone
    of the WM color stands in."""
    red = t["colors"]["red"]
    accents = [t["accent"], t["accent2"], t["accent3"]]
    apart = lambda a, others: all(hue_gap(_hue(a), _hue(o)) >= 25 for o in others)  # noqa: E731
    wm = next((a for a in accents if apart(a, [red])), mix(t["accent"], t["colors"]["text"], 0.35))
    rest = [a for a in accents if a != wm and apart(a, [red, wm])]
    if rest:
        pc = max(rest, key=lambda a: hue_gap(_hue(a), _hue(wm)))
    else:
        pc = mix(wm, t["colors"]["text"], 0.45)
    return red, wm, pc


def second_hue(t):
    return section_colors(t)[2]


def fastfetch_colors(t):
    """What each part of Perihelion's fastfetch layout gets, like Event
    Horizon's and pywal's terminals: the logo a darker shade of the main
    color with its highlight in the main color; the OS section in the
    palette's red-pink (Material You: its error color), WM in accent 1, PC in
    a second hue (see second_hue); values in text lightly tinted toward the
    main color."""
    c = t["colors"]
    a1 = t["accent"]
    shade = mix(a1, c["text"], 0.25) if t.get("light") else mix(a1, c["crust"], 0.38)
    return {
        "logo1": ansi(shade), "logo2": ansi(a1),
        "title": ansi(a1, True), "output": ansi(mix(c["text"], a1, 0.12)),
        "separator": ansi(c["overlay1"]),
        "sections": tuple(ansi(x, True) for x in section_colors(t)),
    }


# A module object: braces inside its strings ("format": "{5} {1}") included.
_FF_OBJECT = r'\{(?:[^{}"]|"(?:[^"\\]|\\.)*")*\}'


def update_fastfetch(path, t, default_path):
    """Recolor Perihelion's fastfetch layout in place (see fastfetch_colors).
    Sections are counted by the "break"s between modules. Only while the
    file is still ours."""
    cur = read(path)
    if cur is None:
        return False
    default = read(default_path) if default_path else None
    if MARKER not in cur and cur != default:
        return False
    f = fastfetch_colors(t)
    new = re.sub(r'"color": \{ "1": "[^"]*", "2": "[^"]*" \}',
                 f'"color": {{ "1": "{f["logo1"]}", "2": "{f["logo2"]}" }}', cur)
    new = re.sub(r'"color": \{ "title": "[^"]*", "output": "[^"]*", "separator": "[^"]*" \}',
                 f'"color": {{ "title": "{f["title"]}", "output": "{f["output"]}", '
                 f'"separator": "{f["separator"]}" }}', new)
    start = new.find('"modules"')
    if start >= 0:
        section = 0
        out = [new[:start]]
        pos = start
        for m in re.finditer(r'"break"|' + _FF_OBJECT, new[start:]):
            out.append(new[pos:start + m.start()])
            token = m.group(0)
            if token == '"break"':
                section += 1
            elif '"keyColor"' in token:
                color = f["sections"][min(section, len(f["sections"]) - 1)]
                token = re.sub(r'"keyColor": "[^"]*"', f'"keyColor": "{color}"', token)
            out.append(token)
            pos = start + m.end()
        out.append(new[pos:])
        new = "".join(out)
    if MARKER not in new:
        new = FASTFETCH_NOTE + "\n" + new
    return write(path, new)


