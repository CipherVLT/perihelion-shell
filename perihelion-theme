def fuzzel_colors(t):
    c = t["colors"]
    h = lambda v, a="ff": v.lstrip("#") + a  # noqa: E731
    return {
        "background": h(c["base"], "dd"),
        "text": h(c["text"]),
        "prompt": h(t["accent"]),
        "input": h(c["text"]),
        "match": h(t["accent"]),
        "selection": h(c["surface0"]),
        "selection-text": h(c["text"]),
        "selection-match": h(t["accent"]),
        "border": h(t["accent"]),
    }


def mix(a, b, f):
    x, y = hex_rgb(a.lstrip("#")), hex_rgb(b.lstrip("#"))
    return "#{:02x}{:02x}{:02x}".format(*(round(i + (j - i) * f) for i, j in zip(x, y)))


