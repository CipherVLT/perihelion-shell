    c = t["colors"]
    return "\n".join([
        f"# {MARKER}: follows the wallpaper. Pick another theme in Strata's settings to stop.",
        f'name = "Catppuccin {FLAVOR_NAMES[t["flavor"]]} (wallpaper)"',
        f'background = "{c["base"]}"',
        f'surface = "{c["mantle"]}"',
        f'text = "{c["text"]}"',
        f'accent = "{t["accent"]}"',
        f'danger = "{c["red"]}"',
        f'muted = "{c["surface0"]}"',
        f'highlight = "{mix(c["base"], t["accent"], 0.3)}"',
        f'border = "{c["surface1"]}"',
