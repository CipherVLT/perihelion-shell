    p = PALETTES[flavor]
    return {
        "name": name, "light": flavor == "latte",
        "neutrals": {k: p[k] for k in ("crust", "mantle", "base", "surface0", "surface1",
                                       "surface2", "overlay0", "overlay1", "overlay2",
