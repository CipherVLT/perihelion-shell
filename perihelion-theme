# --- Material You, through matugen ----------------------------------------
def matugen_bin():
    found = shutil.which("matugen")
    if found:
        return found
    cargo = os.path.join(HOME, ".cargo", "bin", "matugen")
    return cargo if os.access(cargo, os.X_OK) else None


def _hex_of(v):
    """A role's dark-scheme hex from any matugen JSON layout (2.x to 4.x)."""
    if isinstance(v, str):
        return v[:7].lower() if re.match(r"#[0-9A-Fa-f]{6}", v) else None
    if isinstance(v, dict):
        for k in ("dark", "default", "color", "hex"):
            if k in v:
                h = _hex_of(v[k])
                if h:
                    return h
    return None


def parse_matugen(text, mode="dark"):
    """{role: "#rrggbb"} for the dark (or light) scheme, from matugen's --json hex output."""
    start, end = text.find("{"), text.rfind("}")
    if start < 0 or end < start:
        raise ValueError("no JSON in matugen's output")
    data = json.loads(text[start:end + 1])
    colors = data.get("colors", data)
    if isinstance(colors.get(mode), dict) and "primary" in colors[mode]:
        colors = colors[mode]  # 2.x: colors.dark.<role>
    out = {}
    for role, v in colors.items():
        h = _hex_of(v[mode] if isinstance(v, dict) and mode in v else v)
        if h:
            out[role] = h
    missing = [r for r in ("primary", "secondary", "tertiary", "surface", "on_surface") if r not in out]
    if missing:
        raise ValueError("matugen's output has no " + ", ".join(missing))
    return out


def run_matugen(kind, value, scheme, mode="dark"):
    exe = matugen_bin()
    if not exe:
        raise RuntimeError("matugen isn't installed")
    source = ["image", value] if kind == "image" else ["color", "hex", value]
    base = [exe, *source, "-t", scheme, "-m", mode, "--dry-run", "--json", "hex"]
    # --source-color-index 0 picks the most dominant color without the
    # interactive prompt matugen 4 otherwise shows; older matugen lacks the
    # flag (and never prompted), so retry without it.
    for extra in (["--source-color-index", "0"], []):
        try:
            r = subprocess.run(base + extra, capture_output=True, text=True, timeout=60,
                               stdin=subprocess.DEVNULL, check=False)
        except (OSError, subprocess.SubprocessError) as e:
            raise RuntimeError(f"matugen failed: {e}") from e
        if r.returncode == 0:
            return parse_matugen(r.stdout, mode)
        if extra and "source-color-index" in (r.stderr or ""):
            continue
        last = ((r.stderr or r.stdout).strip().splitlines() or ["no output"])[-1]
        raise RuntimeError(f"matugen failed: {last}")
    raise RuntimeError("matugen failed")


def build_material(md, light=False):
    """Material Design 3 roles in the palette shape every writer uses."""
    bg, fg = md["surface"], md["on_surface"]

    def g(*names, blend):
        """The first role matugen gave, else a surface/on_surface blend."""
        return next((md[n] for n in names if n in md), None) or mix(bg, fg, blend)
    colors = {
        "base": bg,
        "mantle": g("surface_container_low", "surface_dim", blend=0.03),
        "crust": g("surface_container_lowest", blend=0.0),
        "surface0": g("surface_container", "surface_variant", blend=0.08),
        "surface1": g("surface_container_high", blend=0.13),
        "surface2": g("surface_container_highest", blend=0.18),
        "overlay0": g("outline_variant", blend=0.35),
        "overlay1": g("outline", "on_surface_variant", blend=0.55),
        "text": fg,
        "red": md.get("error") or md["primary"],
    }
    # Material roles have no fixed red/green/...; the terminal keeps
    # Catppuccin's (Mocha on dark, Latte on light) so `ls` colors still read.
    ref = PALETTES["latte" if light else "mocha"]
    for role, name in (("ansi_green", "green"), ("ansi_yellow", "yellow"), ("ansi_blue", "blue"),
                       ("ansi_magenta", "pink"), ("ansi_cyan", "teal")):
        colors[role] = "#" + ref[name]
    colors["overlay2"] = colors["overlay1"]
    colors["subtext0"] = mix(colors["text"], colors["overlay1"], 0.35)
    colors["subtext1"] = mix(colors["text"], colors["overlay1"], 0.2)
    return {
        "flavor": "material", "name": "Material You", "light": light, "tint": None,
        "accents": ["primary", "secondary", "tertiary"],
        "colors": colors,
        "accent": md["primary"], "accent2": md["secondary"], "accent3": md["tertiary"],
    }


