# Chroma each neutral step gets when tinted: enough that a purple wallpaper
# gives a dark purple bar and a green one a dark green bar, while staying a
# background (like Material You's surfaces, or pywal's color0).
TINT_CHROMA = {"crust": 0.030, "mantle": 0.032, "base": 0.036, "surface0": 0.042,
               "surface1": 0.045, "surface2": 0.045, "overlay0": 0.040, "overlay1": 0.036,
               "overlay2": 0.032, "subtext0": 0.026, "subtext1": 0.022, "text": 0.018}


def tinted_neutrals(colors, tint, light):
    hue, strength = tint
    out = {}
    for role, c_target in TINT_CHROMA.items():
        if role not in colors:
            continue
        L, C, _ = lch(hex_rgb(colors[role].lstrip("#")))
        c = c_target * (0.7 if light else 1.0) * (0.45 + 0.55 * strength)
        out[role] = oklch_hex(L, max(c, min(C, c)), hue)
    return out


